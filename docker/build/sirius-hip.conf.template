# ---------------------------------------------------------------------------
# -- GENERAL ----------------------------------------------------------------
loglevel = "${SIRIUS_HIP_LOGLEVEL},hyper=info,reqwest=info,actix_web=info"

# Default limit number of records to query if not specified by `max` param in request
max_default = ${SIRIUS_HIP_MAX_DEFAULT}

# Cors allowed origins
cors_whitelist=${CORS_WHITELIST}

# ---------------------------------------------------------------------------
# -- APP DATABASE (Download sessions) ---------------------------------------
# Required for the /files/{session_id}/{file_index} flow.
app_database_url = "${SIRIUS_HIP_APP_DATABASE_URL}"
app_database_max_connections = ${SIRIUS_HIP_APP_DATABASE_MAX_CONNECTIONS}

# ---------------------------------------------------------------------------
# -- JWT AUTHORIZATION ------------------------------------------------------
# TODO: Describe
jwt_auth = "${SIRIUS_HIP_JWT_AUTH}"
jwt_secret = "${AUTH_JWT_SECRET}"
jwt_algorithm = "${AUTH_JWT_ALGO}"

# ---------------------------------------------------------------------------
# -- ONETIME CLEANUP --------------------------------------------------------
[onetime_cleanup]
enabled = ${SIRIUS_HIP_ONETIME_CLEANUP_ENABLED}
interval_secs = ${SIRIUS_HIP_ONETIME_CLEANUP_INTERVAL_SECS}
retention_hours = ${SIRIUS_HIP_ONETIME_CLEANUP_RETENTION_HOURS}
session_batch = ${SIRIUS_HIP_ONETIME_CLEANUP_SESSION_BATCH}
max_batches = ${SIRIUS_HIP_ONETIME_CLEANUP_MAX_BATCHES}
token_delete_limit = ${SIRIUS_HIP_ONETIME_CLEANUP_TOKEN_DELETE_LIMIT}
initial_jitter_max_secs = ${SIRIUS_HIP_ONETIME_CLEANUP_INITIAL_JITTER_MAX_SECS}

# ---------------------------------------------------------------------------
# -- BACKEND PACS -----------------------------------------------------------
[dicomarchive]
# Required
# TODO: Describe [dcm4chee2183, dcm4chee440]
version = "${SIRIUS_HIP_PACS_VERSION}"

# Required
database_url = "${SIRIUS_HIP_PACS_DATABASE_URL}"
# Database maximum connection limit
database_max_connections = ${SIRIUS_HIP_PACS_DATABASE_MAX_CONNECTIONS}

# Optional
# Required only for [html5dicom](https://github.com/opendicom/html5)
# TODO: Describe
#custodianoid = "${SIRIUS_HIP_CUSTODIAN_OID}"

# Optional
# Required only for [html5dicom](https://github.com/opendicom/html5)
# TODO: Describe
#pacsoid = "${SIRIUS_HIP_PACS_OID}"

# Optional
# Required only for [html5dicom](https://github.com/opendicom/html5)
# TODO: Describe
#pacsaet = "${SIRIUS_HIP_PACS_AET}"

# Required
# Wado URL to the upstream PACS. Internal use
# For dcm4chee-4.0.0    http://<ip>:<port>/dcm4chee-arc/wado/DCM4CHEE
# For dcm4chee-2.18.3   http://<ip>:<port>/wado
wadouri= "${SIRIUS_HIP_PACS_WADOURI}"

# Optional
# Base url to build the manifests. It is used to generate the wado url for download the images.
# If not set, default value is the requested server base url (schema://host:port)
# This value can be overridden from request URL with the parameter proxyURI
# From highest to lowest, the order of precedence is proxyURI(URL) -> manifest_base_url(Configuration) -> server_base_url(default)
#manifest_base_url="${SIRIUS_HIP_MANIFEST_BASE_URL}"

# Required
# Transfer syntax to configure in the manifest for retrive images from wado.
# Explicit VR Little Endian     1.2.840.10008.1.2.1
# Implicit VR Endian            1.2.840.10008.1.2
transfer_syntax="${SIRIUS_HIP_TRANSFER_SYNTAX}"

# Required when `filesystems` is configured.
# Filesystem delivery is enabled only for studies created on/after this cutoff.
filesystem_cutoff_date = "${SIRIUS_HIP_FILESYSTEM_CUTOFF_DATE}"

# Optional
# Sets how to get the number of frames in an instance
# The default behavior for a multi-frame instance is to look in the database field instance.ins_attrs and parse binary data stored there.
# By setting number_frames_field Sirius HIP will search in that database field
#number_frames_field = "${SIRIUS_HIP_NUM_FRAMES_FIELD}"

# Optional
# Sets the field of the database study table where the value of the institution is obtained
# If not set no institution filter is performed despite the url query parameter.
# If set, the value is searched in that database field
# Example: "study_custom1"
#institution_field = "${SIRIUS_HIP_INSTITUTION_FIELD}"

# Dicom Zip
#buffer = 4096

# FileSystem Mappings
filesystems = ${SIRIUS_HIP_FS_MAPPINGS}