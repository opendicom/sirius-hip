# ------------------------------------------------------------------------------------- #
# ALL:
# ------------------------------------------------------------------------------------- #
# TIMEZONE:
TZ='America/Argentina/Buenos_Aires'


# ------------------------------------------------------------------------------------- #
# PACS:
# ------------------------------------------------------------------------------------- #
# MYSQL - PACS
MYSQL_ROOT_PASSWORD='root'
MYSQL_DATABASE='pacsdb'
MYSQL_USER='pacs'
MYSQL_PASSWORD='pacs'
MYSQL_HOST='opendicom_pacs_db'
MYSQL_PORT=3306
MYSQL_CONNECT_RETRY=15
JAVA_OPTS=-Ddcm4che.archive.nodename=TEST-DCM4CHEE -Xms512m -Xmx2048m -XX:MaxPermSize=128m

PACS_HOST=opendicom_pacs
PACS_PORT=8080

# ------------------------------------------------------------------------------------- #
# SIRIUS HIP:
# ------------------------------------------------------------------------------------- #
SIRIUS_HIP_JWT_AUTH='none'
SIRIUS_HIP_LOGLEVEL=debug
CORS_WHITELIST=["*"]
SIRIUS_HIP_PACS_VERSION='dcm4chee2183'
SIRIUS_HIP_FS_MAPPINGS='[ 
    { id = 1, path = "/DICOM/archive" }
]'


